# Copy this file to .env and fill in real values:  copy .env.example .env   (macOS/Linux: cp)
# .env is gitignored. Never commit real secrets.

APP_NAME=My API
# development | production
APP_ENV=development

# SQLAlchemy connection URL: dialect+driver://user:password@host:port/database
# Pick ONE. URL-encode special characters in passwords (@ -> %40, # -> %23).
#
#   MySQL (local install):
#     mysql+pymysql://root:root@localhost:3306/appdb?charset=utf8mb4
#   MySQL (docker-compose.mysql.yml db, from your host):
#     mysql+pymysql://root:root@localhost:3307/appdb?charset=utf8mb4
#
#   SQL Server, SQL login (local install):
#     mssql+pyodbc://sa:YourStr0ng!Passw0rd@localhost:1433/appdb?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#   SQL Server, Windows authentication (local install, named instance shown):
#     mssql+pyodbc://@localhost\SQLEXPRESS/appdb?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
#   SQL Server (docker-compose.mssql.yml db, from your host):
#     mssql+pyodbc://sa:YourStr0ng!Passw0rd@localhost:1434/appdb?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#
#   SQLite (no server, quick experiments):
#     sqlite:///./app.db
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/appdb?charset=utf8mb4

# Signs JWTs. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=20

# Used only by docker-compose.mysql.yml
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=appdb

# Used only by docker-compose.mssql.yml
# SQL Server rejects weak passwords: 8+ chars with 3 of upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=YourStr0ng!Passw0rd
MSSQL_DATABASE=appdb
